{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/bin/**)",
      "Read(**/obj/**)",
      "Read(**/.nuxt/**)",
      "Read(**/.output/**)",
      "Read(**/dist/**)",
      "Read(**/package-lock.json)",
      "Read(**/Migrations/*.Designer.cs)",
      "Read(./data/import/**)",
      "Read(./data/applications/**)",
      "Read(./.env)",
      "Read(./backups/**)"
    ]
  }
}
