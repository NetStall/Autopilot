# Copy to .env (never commit .env). Used by docker-compose.yml.
# The defaults match ConnectionStrings:Default in appsettings.Development.json.
# If you change them, override the connection string with dotnet user-secrets (see README).
POSTGRES_DB=jobautopilot
POSTGRES_USER=jobautopilot
POSTGRES_PASSWORD=jobautopilot
POSTGRES_PORT=5432

# Frontend: where the Nuxt app finds the API.
NUXT_PUBLIC_API_BASE=http://localhost:5080
