# Copy to .env (never commit .env). Read by docker-compose.yml and dev.ps1.
# The defaults match ConnectionStrings:Default in appsettings.Development.json.
POSTGRES_DB=jobautopilot
POSTGRES_USER=jobautopilot
POSTGRES_PASSWORD=jobautopilot

# Ports on 127.0.0.1 (change them if something else already uses them).
POSTGRES_PORT=5432
API_PORT=5080
WEB_PORT=3000
