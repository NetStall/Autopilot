  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\JobAutopilot.Core\JobAutopilot.Core.csproj" />
    <ProjectReference Include="..\..\src\JobAutopilot.Infrastructure\JobAutopilot.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\JobAutopilot.Api\JobAutopilot.Api.csproj" />
  </ItemGroup>

</Project>
