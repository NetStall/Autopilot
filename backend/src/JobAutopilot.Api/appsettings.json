{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Arbeitsagentur": {
    "BaseUrl": "https://rest.arbeitsagentur.de/jobboerse/jobsuche-service/",
    "ApiKey": "jobboerse-jobsuche",
    "PageSize": 50,
    "MaxPages": 5,
    "DelayBetweenPagesMs": 300
  },
  "Import": {
    "Searches": [
      { "Keyword": ".NET Entwickler", "Location": "Deggendorf", "RadiusKm": 50, "PublishedWithinDays": 14 },
      { "Keyword": "C# Entwickler", "Location": "Regensburg", "RadiusKm": 30, "PublishedWithinDays": 14 },
      { "Keyword": "Full Stack Entwickler", "Location": "Passau", "RadiusKm": 30, "PublishedWithinDays": 14 },
      { "Keyword": "Softwareentwickler C#", "Location": "Landshut", "RadiusKm": 30, "PublishedWithinDays": 14 }
    ]
  }
}
