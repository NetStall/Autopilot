{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Arbeitsagentur": {
    "BaseUrl": "https://rest.arbeitsagentur.de/jobboerse/jobsuche-service/",
    "ApiKey": "jobboerse-jobsuche",
    "PageSize": 100,
    "MaxPages": 10,
    "DelayBetweenPagesMs": 300,
    "RemoteHomeOfficeFilter": "prozentual_100"
  },
  "Import": {
    "Searches": [
      { "Name": "region-softwareentwickler", "Keyword": "Softwareentwickler", "Location": "Deggendorf", "RadiusKm": 70 },
      { "Name": "region-csharp", "Keyword": "C#", "Location": "Deggendorf", "RadiusKm": 70 },
      { "Name": "region-dotnet", "Keyword": ".NET", "Location": "Deggendorf", "RadiusKm": 70 },
      { "Name": "region-fullstack", "Keyword": "Full Stack", "Location": "Deggendorf", "RadiusKm": 70 },
      { "Name": "region-webentwickler", "Keyword": "Webentwickler", "Location": "Deggendorf", "RadiusKm": 70 },
      { "Name": "region-anwendungsentw", "Keyword": "Anwendungsentwickler", "Location": "Deggendorf", "RadiusKm": 70 },
      { "Name": "region-backend", "Keyword": "Backend", "Location": "Deggendorf", "RadiusKm": 70 },
      { "Name": "region-vue", "Keyword": "Vue", "Location": "Deggendorf", "RadiusKm": 70 },
      { "Name": "remote-csharp", "Keyword": "C#", "RemoteOnly": true },
      { "Name": "remote-dotnet", "Keyword": ".NET", "RemoteOnly": true },
      { "Name": "remote-fullstack", "Keyword": "Full Stack", "RemoteOnly": true },
      { "Name": "remote-vue", "Keyword": "Vue", "RemoteOnly": true },
      { "Name": "remote-softwareentwickler", "Keyword": "Softwareentwickler", "RemoteOnly": true },
      { "Name": "remote-backend", "Keyword": "Backend", "RemoteOnly": true }
    ],
    "ExcludeTitleTerms": [
      "Ausbildung", "Azubi", "Praktikum", "Praktikant", "Praktikantin", "Werkstudent", "Werkstudentin",
      "Duales Studium", "Abschlussarbeit", "Bachelorarbeit", "Masterarbeit", "Schülerpraktikum", "Minijob"
    ]
  }
}
